[
  {
    "name": "paper_insight_search",
    "description": "检索真实学术来源。支持日期、作者、机构、会议、引用量筛选；缺失元数据不会满足筛选，结果是有界候选。",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "limit": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "sources": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "arxiv",
              "openreview",
              "semantic-scholar",
              "openalex",
              "crossref"
            ]
          }
        },
        "since": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "until": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sort": {
          "default": "relevance",
          "type": "string",
          "enum": [
            "relevance",
            "date",
            "citations"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "institution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "venue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "minCitations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "query",
        "limit",
        "sort"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "paper_insight_read",
    "description": "获取学术 URL/DOI/arXiv ID 或工作区内文件的正文与定位，不生成报告。",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "paper_insight_fetch",
    "description": "获取并持久化论文材料；返回 key/runId，之后可离线复用材料分析。",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "paper_insight_analyze",
    "description": "按十个模块分析并本地归档。可指定 modules 子集；传 key/runId 复用已有材料重新分析，生成新版本。耗时数分钟、有模型费用。",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "key": {
          "type": "string",
          "pattern": "^[a-f0-9]{20}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^\\d+-[a-f0-9]{8}$"
        },
        "modules": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "paper",
              "first-principles",
              "sandbox",
              "features",
              "products",
              "experience",
              "landscape",
              "transfer",
              "beginner",
              "decision"
            ]
          }
        },
        "refreshResearch": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "paper_insight_resume",
    "description": "从失败/取消检查点继续，只执行尚未完成的阶段；新建版本保留旧结果。",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-f0-9]{20}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^\\d+-[a-f0-9]{8}$"
        },
        "refreshResearch": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "runId"
      ],
      "additionalProperties": false
    }
  },
